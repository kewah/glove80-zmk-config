//
// Corne Choc Pro layout — synced from Totem config
// - Graphite base
// - Dedicated MOD layer instead of base home row mods
// - Hold EXT for navigation/editing, tap EXT for sticky MOD
// - EXT left hand: one-handed mouse companion (swapper, history, clipboard),
//   mirrored on MOD so tap-then-key one-shots the same shortcuts
// - Dedicated Escape on the far-left home row; Shift directly below it
// - Dedicated Backspace, Enter, and Space; sticky-tap/held SYM and NUM
// - Backspace stays on the inner-left thumb on SYM and NUM (Shift + Backspace sends Delete)
// - Delete stays on the EXT comma position
// - Symbols prioritized for markup and writing
// - SYM + NUM opens the shared media/function layer
// - MOD/EXT + NUM opens the BT layer
// - BT controls on left, RGB controls on right of BT layer
//
// Extra Corne keys vs Totem:
//   Middle-row left outer (pos 14) → Escape
//   Bottom-row left outer (pos 28) → Shift
//   Top-row outers (pos 0, 13), middle-row right outer (pos 27),
//   and bottom-row right outer (pos 39) → &none
//   Center keys (pos 6, 7, 20, 21) → encoder press / &none

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE 0
#define MOD  1
#define EXT  2
#define SYM  3
#define NUM  4
#define MF   5
#define BT   6

#define HYPER_MOD LG(LS(LA(LCTRL)))

/ {
    chosen {
        zmk,physical-layout = &default_layout;
    };
};

/ {
    behaviors {
        apo_dquote: apostrophe_doublequote {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp SQT>, <&kp DQT>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        comma_qmark: comma_question_mark {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp QMARK>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        dot_excl: dot_exclamation {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp EXCL>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        slash_bslash: slash_backslash {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp FSLH>, <&kp BSLH>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        backspace_delete: backspace_delete {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BSPC>, <&kp DEL>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        hm: hybrid_mod {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <300>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&sk>;
            retro-tap;
        };

        ext_mod: ext_or_mod {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&mo>, <&sl>;
            retro-tap;
        };

        // Cmd-Tab app switcher: holds Cmd across taps, released on
        // interrupt (any other key or leaving EXT). Sticky Shift (pos 15)
        // is ignored so it can reverse-cycle without dropping Cmd.
        swapper: swapper {
            compatible = "zmk,behavior-tri-state";
            #binding-cells = <0>;
            bindings = <&kt LGUI>, <&kp TAB>, <&kt LGUI>;
            ignored-key-positions = <15>;
        };

        // Ctrl-Tab tab switcher: same tri-state as swapper but holds Ctrl,
        // so taps cycle tabs while the browser switcher stays up. Sticky
        // Shift (pos 15) is ignored so it can reverse-cycle (Ctrl+Shift+Tab).
        tab_swapper: tab_swapper {
            compatible = "zmk,behavior-tri-state";
            #binding-cells = <0>;
            bindings = <&kt LCTRL>, <&kp TAB>, <&kt LCTRL>;
            ignored-key-positions = <15>;
        };

        // SYM/NUM activate immediately, stay sticky when tapped, and behave
        // momentarily when a non-modifier is pressed while held. Modifier
        // presses do not consume the sticky layer, allowing e.g. tap NUM,
        // tap Ctrl+Shift, then tap 1.
        sticky_layer: sticky_or_held_layer {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <1>;
            release-after-ms = <1000>;
            bindings = <&mo>;
            quick-release;
            ignore-modifiers;
        };
    };

    macros {
        // Instant switch to previous app: Cmd released right away so
        // the macOS switcher UI never shows (unlike &kp LG(TAB)).
        quick_swap: quick_app_swap {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LGUI>,
                       <&macro_tap &kp TAB>,
                       <&macro_release &kp LGUI>;
        };

        tmx: tmux_prefix {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL>,
                       <&macro_tap &kp SPACE>,
                       <&macro_release &kp LCTRL>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // Word-left: H + A (Corne positions 23 + 24)
        combo_word_left {
            timeout-ms = <50>;
            key-positions = <23 24>;
            bindings = <&kp LA(LEFT)>;
            layers = <EXT>;
        };

        // Word-right: A + E (Corne positions 24 + 25)
        combo_word_right {
            timeout-ms = <50>;
            key-positions = <24 25>;
            bindings = <&kp LA(RIGHT)>;
            layers = <EXT>;
        };

        // Keep parentheses, angle brackets, and square brackets on direct keys.
        // Braces use the same index-middle fingers: openings above, closings below.
        combo_sym_lbrc {
            timeout-ms = <50>;
            key-positions = <23 24>;
            bindings = <&kp LBRC>;
            layers = <SYM>;
        };

        combo_sym_rbrc {
            timeout-ms = <50>;
            key-positions = <35 36>;
            bindings = <&kp RBRC>;
            layers = <SYM>;
        };

        // The mirrored outer layer thumbs open Media/Function together.
        // Media/Function: SYM + NUM (Corne positions 40 + 45)
        combo_mf_layer_thumbs {
            timeout-ms = <100>;
            key-positions = <40 45>;
            bindings = <&mo MF>;
            layers = <BASE>;
        };

        // MOD/EXT + the right outer NUM key is reserved for maintenance.
        // BT layer: Corne positions 41 + 45.
        combo_bt {
            timeout-ms = <100>;
            key-positions = <41 45>;
            bindings = <&mo BT>;
            layers = <BASE>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            label = "BASE";
            bindings = <
        //  ┌─extra─┐                                                          ┌─enc──┐ ┌─enc──┐                                                          ┌─extra─┐
            &none     &kp B        &kp L        &kp D        &kp W     &kp Z    &kp C_MUTE &kp C_PP &apo_dquote &kp F        &kp O        &kp U        &kp J     &none
        //  ┌outer-L┐                                                          ┌─ctr──┐ ┌─ctr──┐                                                          ┌outer-R┐
            &kp ESC    &kp N       &kp R        &kp T        &kp S     &kp G    &none  &none    &kp Y       &kp H        &kp A        &kp E        &kp I     &none
        //  ┌─extra─┐                                                                                                                                      ┌─extra─┐
            &kp LSHFT  &kp Q        &kp X        &kp M        &kp C     &kp V                    &kp K       &kp P        &comma_qmark &dot_excl    &slash_bslash &none
                                          &sticky_layer SYM      &ext_mod EXT MOD  &backspace_delete                    &kp RET  &kp SPACE  &sticky_layer NUM
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_UP PG_DN &inc_dec_kp C_PREV C_NEXT &inc_dec_kp C_BRI_DN C_BRI_UP>;
        };

        mod_layer {
            label = "MOD";
            bindings = <
            &none        &kp LG(LBKT)  &kp LC(TAB)  &quick_swap  &kp LG(W)    &kp LG(Z)        &trans &trans &trans       &trans       &trans       &trans       &trans       &none
            &kp ESC       &hm LSHFT LSHFT &hm LALT LALT &hm LCTRL LCTRL &hm LGUI LGUI &kp LG(R) &trans &trans &trans &hm HYPER_MOD HYPER_MOD &trans &trans &tmx &trans
            &none        &kp LG(RBKT)  &kp LG(X)    &kp LG(A)    &kp LG(C)    &kp LG(V)                     &trans       &trans       &trans       &trans       &trans       &none
                                             &trans       &trans       &trans                     &kp LS(RET)  &trans       &trans
            >;
        };

        ext_layer {
            label = "EXT";
            bindings = <
            &none        &kp LG(LBKT)  &tab_swapper &swapper     &kp LG(W)    &kp LG(Z)        &trans &trans &kp RALT     &kp HOME     &kp END      &none        &kp PG_UP    &none
            &kp LG(GRAVE) &sk LSHFT     &sk LALT     &sk LCTRL    &sk LGUI     &kp LG(R)        &trans &trans &kp LEFT     &kp DOWN     &kp UP       &kp RIGHT    &tmx         &none
            &none        &kp LG(RBKT)  &kp LG(X)    &kp LG(A)    &kp LG(C)    &kp LG(V)                     &none        &kp TAB      &kp DEL      &none        &kp PG_DN    &none
                                             &trans       &trans       &trans                      &kp LS(RET)  &trans       &trans
            >;
        };

        sym_layer {
            label = "SYM";
            bindings = <
            &none  &none        &kp CARET    &kp AMPS     &kp PIPE     &none         &trans &trans &kp TILDE    &kp AT       &kp GRAVE    &kp HASH     &kp DLLR     &none
            &none  &sk LSHFT    &sk LALT     &sk LCTRL    &sk LGUI     &sk HYPER_MOD &trans &trans &kp MINUS    &kp LPAR     &kp LT       &kp LBKT     &kp COLON    &none
            &none  &none        &none        &none        &none        &none                      &kp UNDER    &kp RPAR     &kp GT       &kp RBKT     &kp SEMI     &none
                                             &trans       &trans       &backspace_delete           &trans       &trans       &trans
            >;
        };

        num_layer {
            label = "NUM";
            bindings = <
            &none  &kp FSLH     &kp N7       &kp N8       &kp N9       &kp PRCNT     &trans &trans &none        &none        &none        &none        &none        &none
            &none  &kp MINUS    &kp N1       &kp N2       &kp N3       &kp PLUS      &trans &trans &sk HYPER_MOD &sk LGUI    &sk LCTRL    &sk LALT     &sk LSHFT    &none
            &none  &kp COLON    &kp N4       &kp N5       &kp N6       &kp ASTRK                  &kp UNDER    &kp EQUAL    &kp COMMA    &none        &none        &none
                                             &kp DOT      &kp N0       &backspace_delete            &trans       &trans       &trans
            >;
        };

        mf_layer {
            label = "MF";
            bindings = <
            &none  &none        &kp C_MUTE   &kp C_VOL_DN &kp C_VOL_UP &none         &trans &trans &kp F12      &kp F7       &kp F8       &kp F9       &none        &none
            &none  &kp C_STOP   &kp C_PP     &kp C_PREV   &kp C_NEXT   &none         &trans &trans &kp F10      &kp F1       &kp F2       &kp F3       &none        &none
            &none  &none        &kp C_BRI_DN &kp C_BRI_UP &none        &none                      &kp F11      &kp F4       &kp F5       &kp F6       &none        &none
                                             &trans       &trans       &trans                      &trans       &trans       &trans
            >;
        };

        bt_layer {
            label = "BT";
            bindings = <
            &none  &bt BT_CLR   &out OUT_USB &out OUT_BLE &none        &none         &none  &none  &rgb_ug RGB_TOG &rgb_ug RGB_HUI &rgb_ug RGB_HUD &rgb_ug RGB_BRI &rgb_ug RGB_BRD &none
            &none  &bt BT_PRV   &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_NXT  &none  &none  &rgb_ug RGB_EFF &rgb_ug RGB_SAI &rgb_ug RGB_SAD &none           &none           &none
            &none  &none        &bt BT_SEL 3 &bt BT_SEL 4 &none        &none                      &none           &none           &none           &none           &none           &none
                                             &none        &none        &none                       &none           &none           &none
            >;
        };
    };
};
