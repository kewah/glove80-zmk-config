// Glove80 Graphite layout.
// Alpha rows use the inner five columns of physical rows 3, 4, and 5.
// SYM/NUM use only the pinky columns beside the home row; Escape sits above SYM.
// Shift remains beside the left bottom alpha row.
// BASE adds media controls on factory F1-F8 and Dictation (Right Alt) below P.
// BASE sends Alt+Backspace on factory left-side Right; Left remains disabled.
// Backspace and Enter use the thumbs; EXT/MOD + Enter sends Shift+Enter.
// BASE sends Shift+Enter on the bottom row immediately right of Dictation.
// BASE keeps Home/End and Page Up/Down at their factory positions.
// NUM and FN use the extra left bottom row.
// All other additional finger keys and unused thumbs are disabled.
// Thumb positions are anchored to factory keycaps (not ambiguous inner/outer):
//   Layer -> RGB; Backspace -> EXT/MOD; Delete -> Backspace.
//   System/GUI -> BT; Right Alt -> FN; Enter -> Enter; Space -> Space.
//   Other factory thumb positions remain disabled.
// NUM sends . and = on factory left-side Left/Right; 0 stays on EXT/MOD.

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE 0
#define MOD  1
#define EXT  2
#define SYM  3
#define NUM  4
#define FN   5
#define BT   6
#define RGB  7

#define HYPER_MOD LG(LS(LA(LCTRL)))

/ {
    chosen {
        zmk,physical-layout = &physical_layout0;
    };
};

/ {
    behaviors {
        apo_dquote: apostrophe_doublequote {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp SQT>, <&kp DQT>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        comma_qmark: comma_question_mark {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp QMARK>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        dot_excl: dot_exclamation {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp EXCL>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        slash_bslash: slash_backslash {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp FSLH>, <&kp BSLH>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        hm: hybrid_mod {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <300>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&sk>;
            retro-tap;
        };

        ext_mod: ext_or_mod {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&mo>, <&sl>;
            retro-tap;
        };

        // Cmd-Tab app switcher: holds Cmd across taps, released on
        // interrupt (any other key or leaving EXT). Sticky Shift (pos 35)
        // is ignored so it can reverse-cycle without dropping Cmd.
        swapper: swapper {
            compatible = "zmk,behavior-tri-state";
            #binding-cells = <0>;
            bindings = <&kt LGUI>, <&kp TAB>, <&kt LGUI>;
            ignored-key-positions = <35>;
        };

        // Ctrl-Tab tab switcher: same tri-state as swapper but holds Ctrl,
        // so taps cycle tabs while the browser switcher stays up. Sticky
        // Shift (pos 35) is ignored so it can reverse-cycle (Ctrl+Shift+Tab).
        tab_swapper: tab_swapper {
            compatible = "zmk,behavior-tri-state";
            #binding-cells = <0>;
            bindings = <&kt LCTRL>, <&kp TAB>, <&kt LCTRL>;
            ignored-key-positions = <35>;
        };

        // SYM/NUM activate immediately, stay sticky when tapped, and behave
        // momentarily when a non-modifier is pressed while held. Modifier
        // presses do not consume the sticky layer, allowing e.g. tap NUM,
        // tap Ctrl+Shift, then tap 1.
        sticky_layer: sticky_or_held_layer {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <1>;
            release-after-ms = <1000>;
            bindings = <&mo>;
            quick-release;
            ignore-modifiers;
        };
    };

    macros {
        // Instant switch to previous app: Cmd released right away so
        // the macOS switcher UI never shows (unlike &kp LG(TAB)).
        quick_swap: quick_app_swap {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LGUI>,
                       <&macro_tap &kp TAB>,
                       <&macro_release &kp LGUI>;
        };

        tmx: tmux_prefix {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL>,
                       <&macro_tap &kp SPACE>,
                       <&macro_release &kp LCTRL>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // Word-left: H + A (Glove80 positions 41 + 42)
        combo_word_left {
            timeout-ms = <50>;
            key-positions = <41 42>;
            bindings = <&kp LA(LEFT)>;
            layers = <EXT>;
        };

        // Word-right: A + E (Glove80 positions 42 + 43)
        combo_word_right {
            timeout-ms = <50>;
            key-positions = <42 43>;
            bindings = <&kp LA(RIGHT)>;
            layers = <EXT>;
        };

    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            label = "BASE";
            bindings = <
                // Factory F1-F8: brightness, volume, and playback controls
                &kp C_BRI_DN            &kp C_BRI_UP            &kp C_MUTE              &kp C_VOL_DN            &kp C_VOL_UP                                                                                                                                                                                        &kp C_PREV              &kp C_PP                &kp C_NEXT              &none                   &none
                // Number row (unused)
                &none                   &none                   &none                   &none                   &none                   &none                                                                                                                                                                       &none                   &none                   &none                   &none                   &none                   &none
                // Alpha top
                &kp ESC                 &kp B                   &kp L                   &kp D                   &kp W                   &kp Z                                                                                                                                                                       &apo_dquote             &kp F                   &kp O                   &kp U                   &kp J                   &none
                // Alpha home
                &sticky_layer SYM       &kp N                   &kp R                   &kp T                   &kp S                   &kp G                                                                                                                                                                       &kp Y                   &kp H                   &kp A                   &kp E                   &kp I                   &sticky_layer NUM
                // Alpha bottom + upper thumbs
                &kp LSHFT               &kp Q                   &kp X                   &kp M                   &kp C                   &kp V                   &none                   &none                   &mo RGB                 &mo BT                  &none                   &none                   &kp K                   &kp P                   &comma_qmark            &dot_excl               &slash_bslash           &kp PG_UP
                // Extra bottom row: factory Home/End/PgDn, Alt+Backspace on Right, Dictation below P, then Shift+Enter + lower thumbs
                &none                   &kp HOME                &kp END                 &none                   &kp LA(BSPC)                                    &ext_mod EXT MOD        &kp BSPC                &none                   &mo FN                  &kp RET                 &kp SPACE                                       &kp RALT                &kp LS(RET)             &none                   &none                   &kp PG_DN
            >;
        };

        mod_layer {
            label = "MOD";
            bindings = <
                // Function row (unused)
                &none                   &none                   &none                   &none                   &none                                                                                                                                                                                               &none                   &none                   &none                   &none                   &none
                // Number row (unused)
                &none                   &none                   &none                   &none                   &none                   &none                                                                                                                                                                       &none                   &none                   &none                   &none                   &none                   &none
                // Alpha top
                &kp ESC                 &kp LG(LBKT)            &kp LC(TAB)             &quick_swap             &kp LG(W)               &kp LG(Z)                                                                                                                                                                   &trans                  &kp ESC                 &trans                  &trans                  &trans                  &trans
                // Alpha home
                &trans                  &hm LSHFT LSHFT         &hm LALT LALT           &hm LCTRL LCTRL         &hm LGUI LGUI           &kp LG(R)                                                                                                                                                                   &trans                  &hm HYPER_MOD HYPER_MOD &trans                  &trans                  &tmx                    &kp ESC
                // Alpha bottom + upper thumbs
                &none                   &kp LG(RBKT)            &kp LG(X)               &kp LG(A)               &kp LG(C)               &kp LG(V)               &none                   &none                   &none                   &none                   &none                   &none                   &trans                  &trans                  &trans                  &trans                  &trans                  &none
                // Extra bottom row (unused) + lower thumbs
                &none                   &none                   &none                   &none                   &none                                           &trans                  &trans                  &none                   &none                   &kp LS(RET)             &trans                                          &none                   &none                   &none                   &none                   &none
            >;
        };

        ext_layer {
            label = "EXT";
            bindings = <
                // Function row (unused)
                &none                   &none                   &none                   &none                   &none                                                                                                                                                                                               &none                   &none                   &none                   &none                   &none
                // Number row (unused)
                &none                   &none                   &none                   &none                   &none                   &none                                                                                                                                                                       &none                   &none                   &none                   &none                   &none                   &none
                // Alpha top
                &kp LG(GRAVE)           &kp LG(LBKT)            &tab_swapper            &swapper                &kp LG(W)               &kp LG(Z)                                                                                                                                                                   &none                   &kp ESC                 &none                   &none                   &none                   &none
                // Alpha home
                &trans                  &sk LSHFT               &sk LALT                &sk LCTRL               &sk LGUI                &kp LG(R)                                                                                                                                                                   &kp LEFT                &kp DOWN                &kp UP                  &kp RIGHT               &tmx                    &kp ESC
                // Alpha bottom + upper thumbs
                &none                   &kp LG(RBKT)            &kp LG(X)               &kp LG(A)               &kp LG(C)               &kp LG(V)               &none                   &none                   &none                   &none                   &none                   &none                   &none                   &kp TAB                 &kp DEL                 &none                   &none                   &none
                // Extra bottom row (unused) + lower thumbs
                &none                   &none                   &none                   &none                   &none                                           &trans                  &trans                  &none                   &none                   &kp LS(RET)             &trans                                          &none                   &none                   &none                   &none                   &none
            >;
        };

        sym_layer {
            label = "SYM";
            bindings = <
                // Function row (unused)
                &none                   &none                   &none                   &none                   &none                                                                                                                                                                                               &none                   &none                   &none                   &none                   &none
                // Number row (unused)
                &none                   &none                   &none                   &none                   &none                   &none                                                                                                                                                                       &none                   &none                   &none                   &none                   &none                   &none
                // Alpha top
                &none                   &none                   &kp CARET               &kp AMPS                &kp PIPE                &none                                                                                                                                                                       &kp TILDE               &kp AT                  &kp GRAVE               &kp HASH                &kp DLLR                &none
                // Alpha home
                &trans                  &sk LSHFT               &sk LALT                &sk LCTRL               &sk LGUI                &sk HYPER_MOD                                                                                                                                                               &kp MINUS               &kp LPAR                &kp LT                  &kp LBKT                &kp COLON               &kp LBRC
                // Alpha bottom + upper thumbs
                &none                   &none                   &none                   &none                   &none                   &none                   &none                   &none                   &none                   &none                   &none                   &none                   &kp UNDER               &kp RPAR                &kp GT                  &kp RBKT                &kp SEMI                &kp RBRC
                // Extra bottom row (unused) + lower thumbs
                &none                   &none                   &none                   &none                   &none                                           &trans                  &kp BSPC                &none                   &none                   &trans                  &trans                                          &none                   &none                   &none                   &none                   &none
            >;
        };

        num_layer {
            label = "NUM";
            bindings = <
                // Function row (unused)
                &none                   &none                   &none                   &none                   &none                                                                                                                                                                                               &none                   &none                   &none                   &none                   &none
                // Number row (unused)
                &none                   &none                   &none                   &none                   &none                   &none                                                                                                                                                                       &none                   &none                   &none                   &none                   &none                   &none
                // Alpha top
                &none                   &kp FSLH                &kp N7                  &kp N8                  &kp N9                  &kp PRCNT                                                                                                                                                                   &none                   &none                   &none                   &none                   &none                   &none
                // Alpha home
                &kp UNDER               &kp MINUS               &kp N1                  &kp N2                  &kp N3                  &kp PLUS                                                                                                                                                                    &sk HYPER_MOD           &sk LGUI                &sk LCTRL               &sk LALT                &sk LSHFT               &trans
                // Alpha bottom + upper thumbs
                &none                   &kp COLON               &kp N4                  &kp N5                  &kp N6                  &kp ASTRK               &none                   &none                   &none                   &none                   &none                   &none                   &none                   &none                   &kp COMMA               &none                   &none                   &none
                // Extra bottom row: decimal/equal on factory Left/Right + lower thumbs
                &none                   &none                   &none                   &kp DOT                 &kp EQUAL                                       &kp N0                  &kp BSPC                &none                   &none                   &trans                  &trans                                          &none                   &none                   &none                   &none                   &none
            >;
        };

        fn_layer {
            label = "FN";
            bindings = <
                // Function row (unused)
                &none                   &none                   &none                   &none                   &none                                                                                                                                                                                               &none                   &none                   &none                   &none                   &none
                // Number row (unused)
                &none                   &none                   &none                   &none                   &none                   &none                                                                                                                                                                       &none                   &none                   &none                   &none                   &none                   &none
                // Alpha top: F7-F9 match NUM 7-9
                &none                   &none                   &kp F7                  &kp F8                  &kp F9                  &none                                                                                                                                                                       &none                   &none                   &none                   &none                   &none                   &none
                // Alpha home: F1-F3 match NUM 1-3
                &trans                  &none                   &kp F1                  &kp F2                  &kp F3                  &none                                                                                                                                                                       &none                   &none                   &none                   &none                   &none                   &trans
                // Alpha bottom + upper thumbs: F4-F6 match NUM 4-6
                &none                   &none                   &kp F4                  &kp F5                  &kp F6                  &none                   &none                   &none                   &none                   &none                   &none                   &none                   &none                   &none                   &none                   &none                   &none                   &none
                // Extra bottom row: F10-F12 on factory End/Left/Right + lower thumbs
                &none                   &none                   &kp F10                 &kp F11                 &kp F12                                         &trans                  &trans                  &none                   &trans                  &trans                  &trans                                          &none                   &none                   &none                   &none                   &none
            >;
        };

        bt_layer {
            label = "BT";
            bindings = <
                // Function row (unused)
                &none                   &none                   &none                   &none                   &none                                                                                                                                                                                               &none                   &none                   &none                   &none                   &none
                // Number row (unused)
                &none                   &none                   &none                   &none                   &none                   &none                                                                                                                                                                       &none                   &none                   &none                   &none                   &none                   &none
                // Alpha top: output selection
                &none                   &none                   &out OUT_USB            &out OUT_BLE            &none                   &none                                                                                                                                                                       &none                   &none                   &none                   &none                   &none                   &none
                // Alpha home: previous/profile 1-3/next; profile positions match NUM
                &none                   &bt BT_PRV              &bt BT_SEL 1            &bt BT_SEL 2            &bt BT_SEL 3            &bt BT_NXT                                                                                                                                                                  &none                   &none                   &none                   &none                   &none                   &none
                // Alpha bottom + upper thumbs: profile 4 on NUM 4 and held BT trigger
                &none                   &none                   &bt BT_SEL 4            &none                   &none                   &none                   &none                   &none                   &none                   &trans                  &none                   &none                   &none                   &none                   &none                   &none                   &none                   &none
                // Extra bottom row: clear on factory MoErgo/Magic; profile 0 on NUM 0 thumb
                &bt BT_CLR              &none                   &none                   &none                   &none                                           &bt BT_SEL 0            &none                   &none                   &none                   &none                   &none                                           &none                   &none                   &none                   &none                   &none
            >;
        };

        rgb_layer {
            label = "RGB";
            bindings = <
                // Function row (unused)
                &none                   &none                   &none                   &none                   &none                                                                                                                                                                                               &none                   &none                   &none                   &none                   &none
                // Number row (unused)
                &none                   &none                   &none                   &none                   &none                   &none                                                                                                                                                                       &none                   &none                   &none                   &none                   &none                   &none
                // Alpha top: toggle and hue/saturation/brightness/speed increases
                &none                   &none                   &none                   &none                   &none                   &none                                                                                                                                                                       &rgb_ug RGB_TOG         &rgb_ug RGB_HUI         &rgb_ug RGB_SAI         &rgb_ug RGB_BRI         &rgb_ug RGB_SPI         &none
                // Alpha home: status and corresponding decreases
                &none                   &none                   &none                   &none                   &none                   &none                                                                                                                                                                       &rgb_ug RGB_STATUS      &rgb_ug RGB_HUD         &rgb_ug RGB_SAD         &rgb_ug RGB_BRD         &rgb_ug RGB_SPD         &none
                // Alpha bottom + upper thumbs: held RGB trigger and previous/next effects
                &none                   &none                   &none                   &none                   &none                   &none                   &none                   &none                   &trans                  &none                   &none                   &none                   &none                   &rgb_ug RGB_EFR         &rgb_ug RGB_EFF         &none                   &none                   &none
                // Extra bottom row (unused) + lower thumbs
                &none                   &none                   &none                   &none                   &none                                           &none                   &none                   &none                   &none                   &none                   &none                                           &none                   &none                   &none                   &none                   &none
            >;
        };
    };
};
